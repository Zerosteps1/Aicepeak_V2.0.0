# Copy to .env (git-ignored). Read only when ASPNETCORE_ENVIRONMENT=Development;
# real environment variables take precedence. Use single quotes: values in
# double quotes or without quotes expand $VARIABLES.
DB_CON_STR='Host=localhost;Port=5432;Database=aicepeak'
DB_USR='postgres'
DB_PWD='postgres'

# PostgreSQL major version of the local container created by ./start (the app ignores it).
# The tests use their own postgres:17 container (Aicepeak.Api.Tests/Infrastructure/PostgresFixture.cs).
DB_PG_VERSION='17'
