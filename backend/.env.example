# Copy to .env (git-ignored). Read only when ASPNETCORE_ENVIRONMENT=Development;
# real environment variables take precedence. Use single quotes: values in
# double quotes or without quotes expand $VARIABLES.
DB_CON_STR='Host=localhost;Port=5432;Database=aicepeak'
DB_USR='postgres'
DB_PWD='postgres'

# PostgreSQL major version of the local container created by ./start (the app ignores it).
# The tests use their own postgres:17 container (Aicepeak.Api.Tests/Infrastructure/PostgresFixture.cs).
DB_PG_VERSION='17'

# Microsoft Entra ID sign-in (docs/dev-setup.md, "Microsoft Entra sign-in"). Without these values the app still
# starts, but every protected API request answers 401. Replace the placeholders with your app registration's values.
# Client ID of the registration that exposes the API (the aud of its v2 access tokens).
ENTRA_AUDIENCE='<api-client-id>'
# Comma-separated client IDs allowed to call the API (azp), e.g. the SPA's client ID.
ENTRA_CLIENT_IDS='<spa-client-id>'
# Delegated scope a user token must carry (scp).
ENTRA_SCOPE='access_as_user'
# App role a token of a service app must carry (roles).
ENTRA_APP_ROLE='Api.Access'
# Optional OIDC metadata document (absolute https URL); empty uses the multitenant Entra v2 endpoint.
ENTRA_METADATA_ADDRESS=''
