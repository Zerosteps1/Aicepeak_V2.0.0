# Copy to .env (git-ignored). Read only when ASPNETCORE_ENVIRONMENT=Development;
# real environment variables take precedence. Use single quotes: values in
# double quotes or without quotes expand $VARIABLES.
DB_CON_STR='Host=localhost;Port=5432;Database=aicepeak'
DB_USR='postgres'
DB_PWD='postgres'

# PostgreSQL major version of the local container created by ./start (the app ignores it).
# The tests use their own postgres:17 container (Aicepeak.Api.Tests/Infrastructure/PostgresFixture.cs).
DB_PG_VERSION='17'

# Microsoft Entra ID sign-in (docs/dev-setup.md, "Microsoft Entra sign-in"). Without these values the app still
# starts, but every protected API request answers 401. Replace the placeholders with your app registration's values.
# Client ID of the registration that exposes the API (the aud of its v2 access tokens).
ENTRA_AUDIENCE='<api-client-id>'
# Comma-separated client IDs allowed to call the API (azp), e.g. the SPA's client ID.
ENTRA_CLIENT_IDS='<spa-client-id>'
# Delegated scope a user token must carry (scp).
ENTRA_SCOPE='access_as_user'
# App role a token of a service app must carry (roles).
ENTRA_APP_ROLE='Api.Access'
# Optional OIDC metadata document (absolute https URL); empty uses the multitenant Entra v2 endpoint.
ENTRA_METADATA_ADDRESS=''

# The database user needs the CREATEDB privilege: every tenant gets its own database, named after its tenant ID,
# which the app creates and migrates on the tenant's first project request. ./start --migrate only migrates the
# main database (DB_CON_STR). The postgres user of the local container has it.

# Blob storage for uploaded documents. BLOB_PROVIDER selects the adapter; 'azure' is the only one today.
BLOB_PROVIDER='azure'
# The provider's connection string. For Azure it must contain a shared key, which signs the upload URLs.
# 'UseDevelopmentStorage=true' is Azurite, the local Azure Storage emulator (http://127.0.0.1:10000), e.g.:
#   docker run -d --name aicepeak-azurite -p 127.0.0.1:10000:10000 mcr.microsoft.com/azure-storage/azurite:3.38.0 \
#     azurite-blob --blobHost 0.0.0.0 --skipApiVersionCheck
# The browser uploads directly to the storage, so the storage needs a CORS rule for the frontend's origin:
# methods PUT and OPTIONS, allowed headers x-ms-blob-type and content-type. With the Azure CLI, e.g.:
#   az storage cors add --services b --methods PUT OPTIONS --origins <frontend-origin> \
#     --allowed-headers x-ms-blob-type content-type --connection-string 'UseDevelopmentStorage=true'
BLOB_CON_STR='UseDevelopmentStorage=true'

# MOCK (AIC-02): document validation and extraction are simulated. Each simulated step waits this many
# milliseconds times a random factor of 0.5 to 1.5; 0 means no waiting. Default 300.
# The mock reports every document whose name contains 'invalid' (any case) as invalid.
MOCK_PROCESSING_STEP_MS='300'
