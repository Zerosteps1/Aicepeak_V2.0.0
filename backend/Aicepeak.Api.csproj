<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The React app; `dotnet publish` builds it and ships dist/ as wwwroot/. -->
    <FrontendRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'frontend'))</FrontendRoot>
    <!-- The test project lives in a subfolder; keep its sources and build output out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Aicepeak.Api.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Validators" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- Skip with -p:SkipFrontendBuild=true, e.g. when the frontend is built separately. -->
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)dist/**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
