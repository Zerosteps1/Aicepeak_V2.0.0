# Runtime settings for the container image: copy to backend/.env.deploy (git-ignored) and run
#   docker run --rm -p 8080:8080 --env-file backend/.env.deploy aicepeak
# No quotes: docker --env-file keeps them as part of the value. Inside the container, localhost is the
# container itself; host.docker.internal reaches the host (Docker Desktop).
# GSS Encryption Mode=Disable: the runtime image has no Kerberos library; without it Npgsql logs an error at
# every new connection (password authentication works either way).
DB_CON_STR=Host=host.docker.internal;Port=5432;Database=aicepeak;GSS Encryption Mode=Disable
DB_USR=postgres
DB_PWD=postgres

# Microsoft Entra ID: the frontend gets its config from ENTRA_AUDIENCE and ENTRA_SCOPE as well.
ENTRA_AUDIENCE=<client-id>
ENTRA_CLIENT_IDS=<client-id>
ENTRA_SCOPE=access_as_user
ENTRA_APP_ROLE=Api.Access
ENTRA_METADATA_ADDRESS=
