{
  "schema_version": 2,
  "repository": "Zerosteps1/Aicepeak_V2.0.0",
  "ruleset_names": {
    "validation": "Factory validation: {branch}",
    "production": "Factory production: {branch}",
    "lifecycle": "Factory branch lifecycle"
  },
  "retired_ruleset_names": [
    "Factory mandatory review and checks",
    "Factory human PR merges only"
  ],
  "production_merge_methods": [
    "squash",
    "rebase"
  ],
  "actions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "selected_actions": {
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": []
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "environment_secrets": [
    "FACTORY_PUBLISHER_APP_PRIVATE_KEY",
    "FACTORY_WRITER_APP_PRIVATE_KEY",
    "CONTEXT7_API_KEY"
  ],
  "optional_environment_secrets": [],
  "promotion_environment": "factory-promotion",
  "promotion_environment_secrets": [
    "FACTORY_PUBLISHER_APP_PRIVATE_KEY"
  ],
  "publisher_permissions": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "write",
    "checks": "write",
    "actions": "read"
  },
  "writer_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write"
  }
}
