# Microsoft Entra ID sign-in. Copy to .env (git-ignored) and fill in the values of your app registrations.
# Client ID of the single-page application registration.
VITE_ENTRA_CLIENT_ID=<spa-client-id>
# Full scope of the API registration that the frontend requests an access token for.
VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
