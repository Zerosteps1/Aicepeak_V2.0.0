{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "vitest"
  ],
  "jsPlugins": [
    "./lint/aicepeak-state.js"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "aicepeak-state/no-state-copy-init": "error",
    "aicepeak-state/no-sync-state-effect": "error",
    "aicepeak-state/no-ref-mirror": "error",
    "aicepeak-state/no-router-state": "error",
    "aicepeak-state/context-files-only": "error"
  }
}
